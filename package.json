{
  "name": "online-video-workspace",
  "private": true,
  "scripts": {
    "format": "biome format",
    "format:write": "biome format --write",
    "lint": "biome lint",
    "lint:write": "biome lint --write",
    "check": "biome check",
    "check:write": "biome check --write",
    "ci": "biome ci",
    "prettier:format": "prettier --check \"**/*.{md,markdown,yml,yaml}\" --no-error-on-unmatched-pattern",
    "prettier:format:write": "prettier --write \"**/*.{md,markdown,yml,yaml}\" --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "prettier": "3.9.9"
  },
  "dependencies": {}
}
