# MySQL 连接串。格式：mysql://用户名:密码@主机:端口/数据库
# 本地开发用 compose 起在宿主机的 MySQL（127.0.0.1:3306）；
# Docker 部署用仓库根目录的 .env（compose bind mount 到 /app/.env，
# 主机是 compose 网络内的服务名 mysql）。参考根目录的 .env.example。
DATABASE_URL=mysql://app:app_dev_pw@127.0.0.1:3306/online_video

# 连接池大小，可选，默认 10
DATABASE_CONNECTION_LIMIT=10
